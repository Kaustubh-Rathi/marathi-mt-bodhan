# Copy to .env (gitignored). NEVER commit real tokens.
# On Kaggle you do NOT need this file: the token comes from the HF_TOKEN
# Kaggle Secret or the private hf-token Dataset (see scripts/kaggle/README.md).

# HuggingFace token. READ role is enough for training+eval downloads;
# WRITE role is required only if you enable hub.push_to_hub.
HF_TOKEN=<your_huggingface_token_here>

# --- Optional knobs (all have sane defaults; used by scripts/kaggle/*) ---
# MR_MT_REPO_URL=https://github.com/Kaustubh-Rathi/marathi-mt-bodhan.git
# MR_MT_REPO_DIR=/kaggle/working/marathi-mt-bodhan
# MR_MT_INSTALL=0            # 1 -> pip-install the pinned stack on kernel start
# MR_MT_RESUME=              # "auto" -> restore latest confirmed Drive checkpoint
# MR_MT_ADAPTER=             # adapter path/HF id for kernel_evaluate.py
# MR_MT_FAMILY=bodhan        # bodhan | indictrans2 for kernel_evaluate.py

# Kaggle API credentials are NOT stored here: the CLI uses
# ~/.kaggle/kaggle.json (or access_token*) — outside the repo, and the
# patterns above are gitignored regardless. scripts/pull_kaggle_output.ps1
# reads them per-account from ~/.kaggle/.
# rclone Drive credentials live in the private gdrive-creds Kaggle Dataset
# (rclone.conf) and locally in your rclone profile — never in the repo.
